@startuml Messenger Private Messaging Sequence
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 20
skinparam BoxPadding 10

actor "User A" as A
actor "User B" as B
participant "Messenger" as M
participant "Conversation &\nAuthorization" as Auth
participant "Message Store" as Msg

== Open Private Conversation ==

A -> M : Create / open private conversation with User B
M -> Auth : Verify A is a participant
Auth -> Auth : Check private-conversation membership

alt A is not authorized
    Auth --> M : Authorization denied
    M --> A : Access denied / error
else A is authorized
    Auth --> M : Authorization granted
    M -> Msg : Retrieve stored message history
    Msg --> M : Message history
    M --> A : Conversation history + participants
end

== Send Private Message ==

A -> M : Submit text message
M -> Auth : Verify A is a participant
Auth --> M : Authorization result

alt A is not authorized or message is invalid
    M --> A : Reject message + actionable error
else Message is valid and authorized
    M -> Msg : Persist message(author, conversation, timestamp)
    Msg --> M : Persistence confirmed
    M --> A : Message accepted
end

@enduml
